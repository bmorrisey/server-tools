# Secrets for server-tools. Copy next to your docker-compose.yml as ".env".
# Values here are referenced from config.json as ${VAR_NAME}.

# Encrypts every backup artifact (AES-256-GCM, scrypt-derived key).
# Generate one:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE SAFE: without it your backups cannot be restored.
BACKUP_PASSPHRASE=

# S3-compatible offsite storage (optional; leave empty to keep backups local).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMTP password for alert + login email (optional).
SMTP_PASSWORD=

# Bearer token an application metrics HTTP source expects (optional; see
# docs/METRICS.md).
APP_METRICS_TOKEN=

# Bearer tokens for the read-only /connect data endpoints (optional; one per
# external consumer such as a Grafana, Superset, or Redash instance).
# Generate each:  openssl rand -hex 32
# See docs/DASHBOARDS.md. A missing value fails validation rather than
# leaving an endpoint guarded by an empty token.
CONNECT_TOKEN_CHARTING=

# debug | info | warn | error
LOG_LEVEL=info
